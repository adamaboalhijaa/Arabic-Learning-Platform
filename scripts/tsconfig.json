{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // These scripts are executed with tsx, never compiled to disk, so they can
    // import TypeScript sources directly (including workspace libs with the
    // explicit .ts extension). Keeping emit disabled also avoids rootDir
    // conflicts for files that live outside scripts/src.
    "noEmit": true,
    "incremental": false,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src"]
}
